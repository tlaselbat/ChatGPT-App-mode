{
  "name": "chatgpt-app-mode",
  "version": "1.0.0",
  "private": true,
  "description": "ChatGPT App Mode launcher and offline visual test harness.",
  "scripts": {
    "test": "playwright test",
    "test:runtime": "node --test tests/runtime.cjs tests/release.cjs",
    "test:host": "node --test --test-concurrency=1 tests/window-host.cjs tests/review-actions.cjs",
    "test:all": "npm test && npm run test:runtime && npm run test:host",
    "test:headed": "playwright test --headed",
    "test:update": "playwright test --update-snapshots",
    "test:report": "playwright show-report playwright-report",
    "live:audit": "node tools/live-audit.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  },
  "dependencies": {
    "electron": "44.10.0"
  }
}
