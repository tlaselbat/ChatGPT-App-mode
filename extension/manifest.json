{
  "manifest_version": 3,
  "name": "ChatGPT App Mode Overrides",
  "version": "0.1.0",
  "description": "Local CSS and JS overrides for ChatGPT App Mode.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "css": [
        "styles/chatgpt-overrides.css"
      ],
      "js": [
        "scripts/chatgpt-overrides.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
