{
  "manifest_version": 3,
  "name": "ChatGPT App Mode Overrides",
  "version": "0.2.1",
  "description": "Local CSS and JS overrides for ChatGPT App Mode.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "css": [
        "styles/chatgpt-overrides.css"
      ],
      "js": [
        "scripts/00-runtime.js",
        "scripts/10-sidebar.js",
        "scripts/20-home.js",
        "scripts/30-share.js",
        "scripts/40-lifecycle.js",
        "scripts/50-pin.js",
        "scripts/chatgpt-overrides.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
